# claw-mock version pins — single source of truth.
# Read by .github/workflows/validate.yml and .github/workflows/deploy.yml.
# Bump a value here and a PR / merge will rebuild the image with it.

# Upstream openclaw base image (FROM in builder/Dockerfile).
# Tag matches https://github.com/openclaw/openclaw releases.
OPENCLAW_UPSTREAM=v2026.10.7

# The upstream bridge release the bridge-state initContainer runs. State written
# before July 2026 (this project's v2026.7.1 era) must pass through this
# release's `doctor --fix` before any 2026.10.x will open it: the retired
# plugin and workspace JSON imports live here and nowhere later. Mirrored into
# ACR as openclaw-base:<this>, like OPENCLAW_UPSTREAM. ghcr's tag has no
# leading "v".
OPENCLAW_BRIDGE=v2026.9.5

# Tools baked into the openclaw image.
# Kept EQUAL to aks_version in main.tf. The client is what the mocker skill
# and the db-mocker CronJob use against that exact server, and AKS publishes
# no 1.36.4 -- a kubectl ahead of every available server is a skew nobody
# chose. Bump the two together or not at all.
KUBECTL_VERSION=1.37.1
SQLCMD_VERSION=1.10.0
# mermaid-cli renders charts to PNG/SVG. Verified against npm, which is where
# the Dockerfile installs it from -- the GitHub release tags differ.
MERMAID_CLI_VERSION=11.17.0
# OpenTofu used by the CI pipelines (state is encrypted; Terraform cannot read it).
TOFU_VERSION=1.13.2
