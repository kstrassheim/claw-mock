<?xml version="1.0" encoding="utf-8"?>
<!--
  Northwind SQL database project (classic schema, dbo).

  Build the dacpac:
    dotnet build Northwind.sqlproj -c Release
    -> bin/Release/Northwind.dacpac

  Deploy locally (VS Code "SQL Database Projects" extension, or CLI):
    sqlpackage /a:Publish \
      /sf:bin/Release/Northwind.dacpac \
      /tsn:<server> /tdn:Northwind \
      /tu:<user> /tp:<password> \
      /v:BotPassword="<password for the contained user clawmockbot>"

  SDK: MSBuild.Sdk.SqlProj (cross-platform, builds on any dotnet SDK —
  this is what the CI dacpac-build job uses on ubuntu-latest).
-->
<Project Sdk="MSBuild.Sdk.SqlProj/3.1.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <SqlServerVersion>SqlAzure</SqlServerVersion>
    <RunSqlCodeAnalysis>False</RunSqlCodeAnalysis>
  </PropertyGroup>
  <ItemGroup>
    <PostDeploy Include="Scripts\PostDeployment.sql" />
  </ItemGroup>
</Project>
