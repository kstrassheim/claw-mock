<?xml version="1.0" encoding="utf-8"?>
<!--
  AdventureWorks SQL database project (compact representative subset).

  Build the dacpac:
    dotnet build AdventureWorks.sqlproj -c Release
    -> bin/Release/net8.0/AdventureWorks.dacpac

  Deploy locally (VS Code "SQL Database Projects" extension, or CLI).
  The target Azure SQL server is Entra-only — authenticate with Entra:
    sqlpackage /a:Publish \
      /sf:bin/Release/net8.0/AdventureWorks.dacpac \
      /tsn:<server> /tdn:AdventureWorks \
      /p:Authentication="Active Directory Default"
  (For a local/dind SQL Server without Entra, classic SQL auth works too:
   /tu:sa /tp:<password> — the dacpac itself creates no users.)

  SDK: MSBuild.Sdk.SqlProj (cross-platform, builds on any dotnet SDK —
  this is what the CI dacpac-build job uses on ubuntu-latest).
-->
<Project Sdk="MSBuild.Sdk.SqlProj/3.1.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- SqlProj builds no ref assembly; without this the .NET 8 SDK
         CopyRefAssembly task fails with MSB4044 (empty SourcePath). -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <SqlServerVersion>SqlAzure</SqlServerVersion>
    <RunSqlCodeAnalysis>False</RunSqlCodeAnalysis>
  </PropertyGroup>
  <!--
    No PostDeploy item on purpose. This dacpac is schema only.

    The seed data used to be a post-deployment script inside the package,
    which meant it ran on every single publish. Seeding is a one-time
    concern for an empty database, and this one is deliberately mutated by
    the mock bot between deploys, so it now lives in /seed/AdventureWorks.sql
    and the deploy pipeline applies it only when the database is still
    empty. Re-adding a PostDeploy item here would reintroduce that coupling.
  -->
</Project>
